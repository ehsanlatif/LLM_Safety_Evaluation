# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# Loaded by the scripts (same loader as src/download_datasets.py / src/run_benchmarks.py).

# Hugging Face token (gated models: LlamaGuard-2, some checkpoints)
HF_Token=

# Anthropic API key (frontier models + the unified LLM judge, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# OpenAI API key (gpt-5.5)
OPENAI_API_KEY=
